<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record forcecreate="True" id="ir_cron_gps_device_taecel" model="ir.cron">
        <field name="name">GPSMap Taecel: Read devices to refill</field>
        <field name="model_id" ref="model_gps_devices"/>
        <field name="state">code</field>
        <field name="code">model.run_scheduler_refill()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall" />
        <field name="active" eval="False"/>
    </record>

</odoo>
